# Opcional. development | test | production. Default: development
NODE_ENV=
# Opcional. Puerto HTTP de la api. Default: 3000
PORT=
# Opcional. trace | debug | info | warn | error | fatal | silent. Default: info
LOG_LEVEL=
# Opcional. Nombre del servicio en los logs. Default: api
SERVICE_NAME=
# Requerida. URL del rol nerdose_api. local: postgres://nerdose_api:<password>@127.0.0.1:5432/nerdose
DATABASE_URL=

# Requerida. YYYY-MM-DD, día del desafío #1; mismo valor que en generator
LAUNCH_DATE=
# Requerida. Origen permitido para mutaciones de jugador. local: http://localhost:5173
WEB_ORIGIN=
# Requerida. Origen permitido para mutaciones de /api/admin/*. local: http://localhost:5174
ADMIN_ORIGIN=
# Requerida. Hash scrypt de la contraseña del admin (scrypt$N$r$p$salt$hash). Generarlo con: echo -n '<contraseña>' | pnpm --filter api admin:hash
ADMIN_PASSWORD_HASH=
# Requerida. Secreto HS256 del JWT del admin, 32 o más caracteres aleatorios (openssl rand -base64 48). Rotarlo invalida las sesiones
ADMIN_JWT_SECRET=
# Opcional. Header del proxy de confianza con la IP del cliente. Preferible uno que el proxy pisa (X-Real-IP, CF-Connecting-IP); con X-Forwarded-For se toma la entrada que agregó el proxy, contando TRUST_PROXY_HOPS desde la derecha. Sin valor, el rate limit usa la IP de la conexión (correcto solo sin proxy delante)
TRUST_PROXY_HEADER=
# Opcional. Cantidad de proxies de confianza delante de la api, para leer X-Forwarded-For desde la derecha. Default: 1
TRUST_PROXY_HOPS=
# Opcional. Reportes wrong_answer/ambiguous que alertan un desafío. Default: 3
REPORT_ALERT_COUNT=
# Opcional. Proporción (0 a 1, exclusivos) de reportes sobre Play terminadas que alerta un desafío. Default: 0.05
REPORT_ALERT_RATIO=
# Opcional. Mínimo de reportes para evaluar la proporción. Default: 2
REPORT_ALERT_RATIO_MIN_COUNT=
