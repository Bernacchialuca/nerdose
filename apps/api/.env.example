# Opcional. development | test | production. Default: development
NODE_ENV=
# Opcional. Puerto HTTP de la api. Default: 3000
PORT=
# Opcional. trace | debug | info | warn | error | fatal | silent. Default: info
LOG_LEVEL=
# Opcional. Nombre del servicio en los logs. Default: api
SERVICE_NAME=
# Requerida. URL del rol nerdose_api. local: postgres://nerdose_api:<password>@127.0.0.1:5432/nerdose
DATABASE_URL=

# Requerida. YYYY-MM-DD, día del desafío #1; mismo valor que en generator
LAUNCH_DATE=
# Requerida. Origen permitido para mutaciones de jugador. local: http://localhost:5173
WEB_ORIGIN=
# Requerida. Origen permitido para mutaciones de /api/admin/*. local: http://localhost:5174
ADMIN_ORIGIN=
# Opcional. Header del proxy de confianza con la IP del cliente (p. ej. X-Forwarded-For). Sin valor, el rate limit por IP es un único balde compartido
TRUST_PROXY_HEADER=
