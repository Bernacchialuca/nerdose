# Opcional. development | test | production. Default: development
NODE_ENV=
# Opcional. trace | debug | info | warn | error | fatal | silent. Default: info
LOG_LEVEL=
# Opcional. Nombre del servicio en los logs. Default: generator
SERVICE_NAME=
# Requerida. URL del rol nerdose_generator. local: postgres://nerdose_generator:<password>@127.0.0.1:5432/nerdose
DATABASE_URL=
# Requerida. Fecha de lanzamiento YYYY-MM-DD (UTC). Mismo valor que en la api
LAUNCH_DATE=
# Requerida. Secreto del seed HMAC, 32 caracteres o más, solo en el generator
GENERATOR_SECRET=
# Opcional. Intentos máximos por fecha. Default: 20
GENERATION_MAX_ATTEMPTS=
