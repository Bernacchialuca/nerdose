# Requerida. URL del rol dueño nerdose_owner, solo para db:migrate. local: postgres://nerdose_owner:<POSTGRES_PASSWORD>@127.0.0.1:5432/nerdose
DATABASE_URL_OWNER=
# Opcional. URL del rol nerdose_api; db:migrate fija su contraseña. local: postgres://nerdose_api:<password>@127.0.0.1:5432/nerdose
DATABASE_URL_API=
# Opcional. URL del rol nerdose_generator; db:migrate fija su contraseña. local: postgres://nerdose_generator:<password>@127.0.0.1:5432/nerdose
DATABASE_URL_GENERATOR=
