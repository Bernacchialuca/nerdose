{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "db:migrate": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:migrate"],
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "//#lint:workspace": {},
    "//#typecheck:workspace": {},
    "//#test:workspace": {
      "cache": false
    }
  }
}
